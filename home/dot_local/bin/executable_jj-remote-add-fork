#!/usr/bin/env bash

set -e

usage() {
    echo "Usage: $0 [--name=<name>] [--force|-f]"
    echo ""
    echo "Detect the upstream parent of the current fork, add it as a remote,"
    echo "fetch it, and set trunk() to track its default branch."
    exit 1
}

name="upstream"
force=false
while [[ "$1" =~ ^- ]]; do
    case "$1" in
        --name=*)
            name="${1#*=}"
            shift
            ;;
        --force|-f)
            force=true
            shift
            ;;
        *)
            usage
            ;;
    esac
done

repo_url=$(git remote get-url origin 2>/dev/null)
if [[ -z "$repo_url" ]]; then
    echo "Error: No 'origin' remote found."
    exit 1
fi

if [[ ! $repo_url =~ (github\.com|gitlab\.com)[:/]([^/]+)/([^/.]+) ]]; then
    echo "Error: Unable to parse repository URL: $repo_url"
    exit 1
fi

host="${BASH_REMATCH[1]}"
owner="${BASH_REMATCH[2]}"
repo="${BASH_REMATCH[3]}"

upstream_url=""
default_branch=""

case "$host" in
    github.com)
        api_url="https://api.github.com/repos/$owner/$repo"
        response=$(curl -sf "$api_url" || true)
        upstream_url=$(echo "$response" | jq -r '.parent.ssh_url')
        default_branch=$(echo "$response" | jq -r '.parent.default_branch')
        ;;
    gitlab.com)
        api_url="https://gitlab.com/api/v4/projects/$(echo "$owner/$repo" | sed 's/\//%2F/g')"
        response=$(curl -sf "$api_url" || true)
        upstream_url=$(echo "$response" | jq -r '.forked_from_project.ssh_url_to_repo')
        default_branch=$(echo "$response" | jq -r '.forked_from_project.default_branch')
        ;;
    *)
        echo "Error: Unsupported Git hosting service: $host"
        exit 1
        ;;
esac

if [[ -z "$upstream_url" || "$upstream_url" == "null" ]]; then
    echo "This repository is not a fork, or upstream is unknown."
    exit 0
fi

existing_url=$(jj git remote list | awk -v r="$name" '$1 == r {print $2}')
if [[ -n "$existing_url" ]]; then
    if [[ "$force" == "true" ]]; then
        echo "Removing existing remote '$name'..."
        jj git remote remove "$name"
    else
        echo "Remote '$name' already exists: $existing_url"
        exit 0
    fi
fi

echo "Adding remote '$name': $upstream_url"
jj git remote add "$name" "$upstream_url"
jj git fetch --remote "$name"

if [[ -n "$default_branch" && "$default_branch" != "null" ]]; then
    echo "Setting trunk() to ${default_branch}@${name}"
    jj config set --repo 'revset-aliases."trunk()"' "${default_branch}@${name}"
fi

echo ""
echo "Fork remote configured successfully:"
echo "  $name: $upstream_url"
echo "  trunk(): ${default_branch}@${name}"
