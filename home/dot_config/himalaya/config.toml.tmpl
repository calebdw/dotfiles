display-name = {{ .name | quote }}
downloads-dir = "~/Downloads"

[accounts.proton]
default = true
email = {{ .email | quote }}

backend = "imap"
imap.host = "127.0.0.1"
imap.port = 1143
imap.login = {{ .email | quote }}
imap.auth.type = "password"
imap.auth.keyring = "proton-imap"

message.send.backend = "smtp"
smtp.host = "127.0.0.1"
smtp.port = 1025
smtp.login = {{ .email | quote }}
smtp.auth.type = "password"
smtp.auth.keyring = "proton-smtp"
